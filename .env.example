# MergeMind Configuration

# Environment & Server
NODE_ENV=development
PORT=3000

# AI Provider Settings
# Options: 'gemini' | 'mock'
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro

# GitHub Platform Integration
GITHUB_TOKEN=your_github_personal_access_token_or_app_token
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/mergemind
DATABASE_SSL=false

# Budget & Guardrails
MAX_REVIEW_BUDGET_USD=0.25
MAX_INVESTIGATION_ITERATIONS=2
BATCH_CONCURRENCY=3
LOG_LEVEL=info
