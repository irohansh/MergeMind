ANTHROPIC_API_KEY=your_anthropic_api_key_here
GITHUB_TOKEN=your_github_token_here
DATABASE_URL=your_postgres_database_url_here

# Optional model overrides (defaults to claude-3-5-haiku-20241022 and claude-3-5-sonnet-20241022)
ANTHROPIC_HAIKU_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_SONNET_MODEL=claude-3-5-sonnet-20241022
